<%
  const haySesion = typeof usuario !== "undefined" && usuario;
%>
<% if (haySesion) { %>
<%- include('../plantillas/header', { seccion: '', titulo: 'Página no encontrada' }) %>
<% } else { %>
<%- include('../plantillas/auth_header') %>
<% } %>

<% if (haySesion) { %>
<div class="page-heading">
  <div>
    <p class="eyebrow">Error 404</p>
    <h1>Página no encontrada</h1>
    <p class="subtitle">La dirección que buscas no existe o cambió de lugar.</p>
  </div>
</div>

<div class="card">
  <div class="empty-state">
    <i class="bi bi-compass"></i>
    <p>Revisa la dirección o vuelve al reporte del día.</p>
    <a href="/reportes/diario" class="primary-button">
      <i class="bi bi-arrow-left"></i>Volver al inicio
    </a>
  </div>
</div>
<% } else { %>
<div class="auth-head">
  <div class="auth-logo"><i class="bi bi-compass"></i></div>
  <h1>Página no encontrada</h1>
  <p>La dirección que buscas no existe o cambió de lugar.</p>
</div>
<a class="primary-button" href="/login">
  <i class="bi bi-arrow-left"></i>Volver al inicio
</a>
<% } %>

<% if (haySesion) { %>
<%- include('../plantillas/footer') %>
<% } else { %>
<%- include('../plantillas/auth_footer') %>
<% } %>
