<%- include('../plantillas/header', { seccion: 'tipos', titulo: 'Tipos' }) %>

<%
  const listaTipos = typeof tipos !== "undefined" && tipos ? tipos : [];
%>

<div class="page-heading">
  <div>
    <p class="eyebrow">Lonja</p>
    <h1>Tipos</h1>
  </div>
  <div class="heading-actions">
    <a href="/tipos/crear" class="primary-button">
      <i class="bi bi-plus-lg"></i>Nuevo tipo
    </a>
  </div>
</div>

<div class="card">
  <div class="toolbar">
    <div>
      <strong>Tipos de especie</strong>
      <p><%= listaTipos.length %> <%= listaTipos.length === 1 ? 'tipo registrado' : 'tipos registrados' %></p>
    </div>
    <a href="/tipos/crear" class="ghost-button">
      <i class="bi bi-plus-lg"></i>Agregar
    </a>
  </div>

  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Tipo</th>
          <th class="cell-center">Especies</th>
          <th class="cell-right">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (listaTipos.length) { %>
          <% listaTipos.forEach((t) => { %>
          <tr>
            <td class="row-id">#<%= t.id_tpo %></td>
            <td>
              <div class="cell-main">
                <span class="cell-avatar"><i class="bi bi-tag"></i></span>
                <div>
                  <div class="cell-name"><%= t.nombre %></div>
                  <div class="cell-meta">Tipo #<%= t.id_tpo %></div>
                </div>
              </div>
            </td>
            <td class="cell-center">
              <span class="status <%= t.especies && t.especies.length ? 'success' : 'muted' %>">
                <%= t.especies ? t.especies.length : 0 %>
              </span>
            </td>
            <td>
              <div class="row-actions">
                <a class="icon-action" href="/tipos/<%= t.id_tpo %>/editar" title="Editar">
                  <i class="bi bi-pencil"></i>
                </a>
                <form action="/tipos/<%= t.id_tpo %>?_method=DELETE" method="POST"
                  data-confirm-title="Eliminar tipo"
                  data-confirm="Se eliminará el tipo <%= capitalizar(t.nombre) %>. Esta acción no se puede deshacer.">
        <%- include('../plantillas/csrf') %>
                  <button class="icon-action danger" type="submit" title="Eliminar">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4">
              <div class="empty-state">
                <i class="bi bi-tags"></i>
                <p>Todavía no hay tipos registrados.</p>
                <a href="/tipos/crear" class="primary-button">Registrar el primero</a>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../plantillas/footer') %>
